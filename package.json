{
  "name": "beast.docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve --mode development",
    "build": "rspack build --mode production",
    "size": "bun scripts/size.ts",
    "build:size": "bun run build && bun run size",
    "preview": "rspack serve --mode production",
    "deploy": "bun run build && wrangler deploy",
    "typecheck": "tsrx-tsc --noEmit",
    "check": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@octanejs/motion": "^0.1.57",
    "beast-tsrx": "0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "octane": "0.7.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@beastjs/devtools": "^0.1.12",
    "@octanejs/rspack-plugin": "0.1.55",
    "@rspack/cli": "^2.2.8",
    "@rspack/core": "^2.2.8",
    "@rspack/dev-server": "^2.2.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsrx/typescript-plugin": "0.4.12",
    "@types/node": "^26.6.3",
    "postcss-loader": "^8.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "4.143.0"
  }
}
