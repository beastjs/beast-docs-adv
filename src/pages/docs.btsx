import { Icon } from "@/lib/icons";
import Link from "../components/link.btsx";
import { usePathname } from "../lib/router";
import { useEffect, useState } from "octane";
import CodeBlock from "../components/codeblocks.btsx";
import Sidebar from "../components/sidebar.btsx";
import SiteFooter from "../components/site-footer.btsx";
import SiteHeader from "../components/site-header.btsx";
import { type DocPage, docPages, githubUrl, orderedDocPages } from "../lib/docs";
import ArticleHeader from "../articles/article-header.btsx";
import ArticleSection from "../articles/article-section.btsx";
import ArticlePagination from "../articles/article-pagination.btsx";
module
  function getPage(slug?: string) {
    return docPages[(slug ?? "").replace(/^\/+|\/+$/g, "")];
  }
  function pageSection(page: DocPage) {
    if (page.eyebrow === "Language")
      return "language" as const;
    if (page.eyebrow === "Skills")
      return "skills" as const;
    if (page.eyebrow === "Tooling")
      return "tooling" as const;
    if (page.eyebrow === "Integrations")
      return "integrations" as const;
    if (page.eyebrow === "Examples")
      return "examples" as const;
    return "docs" as const;
  }

component NotFound
  fragment
    SiteHeader(section="docs")
    div(className="site-frame docs-frame")
      Sidebar
      article.docs-article
        header.article-header
          span.section-kicker 404
          h1 Page not found
          p This documentation page does not exist.
          Link(to="/docs") Back to docs
    SiteFooter
component DocsPageRoot
  props { page }: { page: DocPage }
  setup
    const pageIndex = orderedDocPages.findIndex((candidate) => candidate.slug === page.slug);
    const previous = pageIndex > 0 ? orderedDocPages[pageIndex - 1] : undefined;
    const next = pageIndex >= 0 && pageIndex < orderedDocPages.length - 1 ? orderedDocPages[pageIndex + 1] : undefined;
    const currentHref = `/docs${page.slug ? `/${page.slug}` : ""}`;

    useEffect(() => {
      document.title = `${page.title} — Beast`;
    }, [page.title]);

    // Highlight every TOC link whose section is currently on screen.
    const [visibleIds, setVisibleIds] = useState<string[]>([]);
    useEffect(() => {
      const visible = new Set<string>();
      const headerHeight = document.querySelector<HTMLElement>(".site-header")?.offsetHeight ?? 0;
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) visible.add(entry.target.id);
            else visible.delete(entry.target.id);
          }
          setVisibleIds(page.sections.filter((section) => visible.has(section.id)).map((section) => section.id));
        },
        { rootMargin: `-${headerHeight}px 0px 0px 0px` },
      );
      for (const section of page.sections) {
        const element = document.getElementById(section.id);
        if (element) observer.observe(element);
      }
      return () => observer.disconnect();
    }, [page.slug]);
  fragment
    SiteHeader(section={pageSection(page)})
    div(className="site-frame docs-frame")
      Sidebar(currentHref={currentHref})
      main#main-content.docs-main
        article.docs-article
          .breadcrumbs(aria-label="Breadcrumb")
            Link(to="/docs") Docs
            span(aria-hidden="true") /
            span #{page.eyebrow}
          ArticleHeader(page={page} githubUrl={githubUrl})
          .article-rule
          each section in page.sections key section.id
            ArticleSection(section={section})
          ArticlePagination(previous={previous} next={next})
        aside.article-toc(aria-label="On this page")
          p Sections
          nav
            each section in page.sections key section.id
              a(href={`#${section.id}`} className={visibleIds.includes(section.id) ? "is-visible" : undefined}) #{section.title}
          .toc-feedback
            span Was this helpful?
            div
              a(href={`${githubUrl}/issues/new`} target="_blank" rel="noreferrer") Send feedback
    SiteFooter

setup
  const pathname = usePathname();
  const page = pathname === "/docs" || pathname.startsWith("/docs/") ? getPage(pathname.slice("/docs".length)) : undefined;

if page
  DocsPageRoot(page={page})
else
  NotFound
