import { Icon } from "@/lib/icons";
import BeastAudio  from "./components/beast-audio.btsx";
import CornerMarks  from "./components/corner-marks.btsx";
import Sidebar  from "./components/sidebar.btsx";
import SiteFooter  from "./components/site-footer.btsx";
import SiteHeader from "./components/site-header.btsx";
import { githubUrl } from "./lib/navigation";
import { getProjectStatus } from './lib/status'
import { useBeastRelease } from './lib/release'
import Hero from "./sections/hero.btsx";
import Install from "./sections/install.btsx";
import Compiler from "./sections/compiler.btsx";
import Features from "./sections/features.btsx";
import Pipeline from "./sections/pipeline.btsx";
import Explore from "./sections/explore.btsx";
import Status from "./sections/status.btsx";

module
  const command = "bun x create-beast@latest app";



component HomeRoot
  setup const release = useBeastRelease();
  fragment
    SiteHeader(section="home")
    .site-frame
      Sidebar
      main#main-content.landing-main(suppressHydrationWarning)
        .blueprint-lines(aria-hidden="true")
        .landing-container
          Hero(release={release} githubUrl={githubUrl})
          Install(command={command})
          Compiler
          Features
          Pipeline
          Explore
          Status(release={release} githubUrl={githubUrl})
          section(className="section status-section" aria-labelledby="status-title")
            .status-panel
              CornerMarks
              .status-copy
                span.section-kicker Project status
                h2#status-title Early, focused, and tested
                p Beast #{release.version} is alpha software with a deliberately narrow language. The compiler, project builder, bundler integrations, and creator work today; the public API may still evolve.
                a(
                  ~ className="button button-secondary"
                  ~ href={`${githubUrl}#project-status`}
                  ~ target="_blank"
                  ~ rel="noreferrer"
                  ~ )
                  | Read project status
                  Icon(name="arrow-right" size={15} aria-hidden="true")
              .status-ascii(aria-hidden="true")
                pre #{getProjectStatus(release.version)}
    SiteFooter
    BeastAudio

HomeRoot
