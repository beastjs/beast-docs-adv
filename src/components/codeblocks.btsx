import type { HLJSApi } from "highlight.js";
import { useEffect, useState } from "octane";
import CopyButton from "./copy-button.btsx";
module
  type CodeBlockProps = {
    ~ code: string;
    ~ filename?: string;
    ~ language?: string;
    ~ className?: string;
    ~ };

  // highlight.js (plus the custom BTSX/TSRX grammars) is loaded on demand so it
  // stays out of the initial bundle. Code renders as plain text until it arrives.
  let hljsPromise: Promise<HLJSApi> | undefined;
  function loadHighlighter() {
    hljsPromise ??= import("@/lib/btsx-hljs").then((module) => module.default);
    return hljsPromise;
  }

  // Map docs language ids to highlight.js ids
  function normalizeLang(hljs: HLJSApi, lang?: string): string | undefined {
    if (!lang)
      return undefined;
    const l = lang.toLowerCase();
    if (l === "btsx" || l === "beast")
      return "btsx";
    if (l === "tsrx")
      return "tsrx";
    if (l === "shell" || l === "bash" || l === "sh")
      return "bash";
    if (l === "text" || l === "txt")
      return undefined;
    // highlight.js uses "typescript" for ts, "javascript" for js
    if (["ts", "typescript", "tsx", "js", "javascript", "css", "json", "html", "xml"].includes(l))
      return l;
    return hljs.getLanguage(l) ? l : undefined;
  }

  function highlight(hljs: HLJSApi, code: string, language?: string): string | null {
    const lang = normalizeLang(hljs, language);
    if (!lang)
      return null;
    try {
      return hljs.getLanguage(lang)
        ? hljs.highlight(code, { language: lang }).value
        : hljs.highlightAuto(code).value;
    }
    catch {
      return null;
    }
  }
component CodeBlockRoot
  props { code, filename, language, className = "" }: CodeBlockProps
  setup
    const [highlighted, setHighlighted] = useState<string | null>(null);

    useEffect(() => {
      let active = true;
      setHighlighted(null);
      loadHighlighter().then((hljs) => {
        if (active)
          setHighlighted(highlight(hljs, code, language));
      });
      return () => {
        active = false;
      };
    }, [code, language]);

    const lines = highlighted ? highlighted.split("\n") : null;
  div(suppressHydrationWarning className={`code-block ${className}`.trim()})
    .code-block-header
      span.code-file #{filename ?? "Code"}
      span.code-header-actions
        if language
          span.code-language #{language}
        CopyButton(value={code} compact)
    pre
      code(suppressHydrationWarning)
        if lines
          each line, index in lines key index
            span.code-line(suppressHydrationWarning)
              span.line-number(aria-hidden="true") #{index + 1}
              span(className="line-content hljs" dangerouslySetInnerHTML={{ __html: line || " " }})
        else
          each line, index in code.split("\n") key `${index}-${line}`
            span.code-line
              span.line-number(aria-hidden="true") #{index + 1}
              span.line-content #{line || " "}

props {...props}: CodeBlockProps
CodeBlockRoot({...props})
