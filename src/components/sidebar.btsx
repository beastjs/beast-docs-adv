import Link from "./link.btsx";
import { Icon } from "@/lib/icons";
import { navigation } from "../lib/navigation";
import { useBeastRelease } from "../lib/release";
import type { NavigationItem } from "../lib/navigation.ts"
import type { BeastRelease } from "../lib/release.ts"
module
  type SidebarProps = {
    ~ currentHref?: string;
    ~ };
module
  interface SidebarItemProps {
    item: NavigationItem
    currentHref: string
  }

component SidebarItem
  props { item, currentHref }: SidebarItemProps
  li
    if item.external
      a.sidebar-link(href={item.href} target="_blank" rel="noreferrer")
        span #{item.label}
        Icon(name='arrow-up-right' size={12} aria-hidden="true")
    else
      Link(
        ~ className={`sidebar-link${currentHref === item.href ? " active" : ""}`}
        ~ to={item.href}
        ~ aria-current={currentHref === item.href ? "page" : undefined}
        ~ )
        | #{item.label}

module
  interface SidebarItemListProps {
    currentHref: string
  }

component SidebarItemList
  props { currentHref }: SidebarItemListProps
  each section in navigation key section.label
    section.sidebar-section
      p.sidebar-label #{section.label}
      ul
        each item in section.items key item.href
          SidebarItem(item={item} currentHref={currentHref})

module
  interface SidebarStatusProps {
    release: BeastRelease
  }

component SidebarStatus
  props { release }: SidebarStatusProps
  .sidebar-status
    span.status-dot(aria-hidden="true")
      Icon(name='circle-dot' size={13})
    span
      strong Beast #{release.version}
      small Alpha release

component SidebarRoot
  props { currentHref = "" }: SidebarProps
  setup const release = useBeastRelease();
  .sidebar-column
    aside.sidebar
      nav(
        ~ className="sidebar-nav font-okx"
        ~ aria-label="Documentation"
        ~ )
        SidebarItemList(currentHref={currentHref})
      SidebarStatus(release={release})

props {...props}: SidebarProps
SidebarRoot({...props})
