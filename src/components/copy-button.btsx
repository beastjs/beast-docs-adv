module "use client";
import { useRef, useState, type ClassValue } from "octane";
import { Icon } from "@/lib/icons";
import { cn } from "@/lib/utils";
import AnimatedIcon from "./animated-icon.btsx";
module
  type CopyButtonProps = {
    ~ value: string;
    ~ label?: string;
    ~ compact?: boolean;
    ~ className?: ClassValue;
    ~ };
component CopyButtonRoot
  props { value, label = "Copy", compact = false, className }: CopyButtonProps
  setup
    const [copied, setCopied] = useState(false);
    const timeoutRef = useRef<ReturnType<typeof setTimeout> | null>(null);

    async function copy() {
      try {
        await navigator.clipboard.writeText(value);
        setCopied(true);
        if (timeoutRef.current)
          clearTimeout(timeoutRef.current);
        timeoutRef.current = setTimeout(() => setCopied(false), 1600);
      }
      catch {
        setCopied(false);
      }
    }
  button(
    ~ type="button"
    ~ className={cn('copy-button overflow-hidden', className)}
    ~ onClick={copy}
    ~ aria-label={copied ? "Copied" : label}
    ~ title={copied ? "Copied" : label}
    ~ )
    AnimatedIcon(idleIcon='copy' activeIcon='copied' active={copied} className={cn('size-4', {'text-white': copied})})
    if !(compact)
      span #{copied ? "Copied" : label}

props {...props}: CopyButtonProps
CopyButtonRoot({...props})
