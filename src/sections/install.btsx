import {Icon} from "../lib/icons";
import CornerMarks from "../components/corner-marks.btsx";
import CopyButton from "../components/copy-button.btsx";

props { command}: {command: string}
section(className="section install-section" aria-labelledby="install-title")
  .section-heading-row
    div
      span(className="section-kicker opacity-80") Quick start
      h2#install-title Create a Beast App.
  .install-panel
    CornerMarks
    .install-copy
      span.feature-icon
        Icon(name="terminal" aria-hidden="true")
      div
        h3(className='h-8 flex items-center')
          span Fully configured pipeline
        p The Beast project creator wires the compiler, Octane, TSRX checking, your chosen bundler, and an Octane-native UI library into a project you can inspect end to end.
    .command-block
      span(className="ps-3 grid place-items-center font-mono font-light text-foreground/40 text-xs" aria-hidden="true") $
      code #{command}
      CopyButton(value={command} label="")
    .install-details
      span
        Icon(name="checkbox-checked")
        |  Typed starter
      span
        Icon(name="checkbox-checked")
        |  HMR ready
      span
        Icon(name="checkbox-checked")
        |  Production build
